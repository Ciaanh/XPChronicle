<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

	<!-- XP Bar Enhanced - FlatBar Template  -->
	<!-- Follows project conventions from existing FlatXPBar.xml -->

	<Script file="FlatBarStyle.lua"/>

	<Frame name="FlatBarTemplate" virtual="true" mixin="FlatBarXPBarMixin" frameStrata="LOW" enableMouse="true" fixedFrameStrata="true">
		<Size x="565" y="30"/>
		<Layers>
			<!-- Background layer -->
			<Layer level="BACKGROUND" textureSubLevel="1">
				<Texture parentKey="Background" setAllPoints="true">
					<Color r="0" g="0" b="0" a="0.5"/>
				</Texture>
			</Layer>

			<!-- Flash effect overlay -->
			<Layer level="OVERLAY" textureSubLevel="3">
				<Texture parentKey="GainFlash" hidden="true" alphaMode="BLEND">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<!-- XP StatusBar (solid color, no texture atlas) -->
			<StatusBar parentKey="StatusBar" minValue="0" maxValue="1" defaultValue="0">
				<Size x="565" y="30"/>
				<Anchors>
					<Anchor point="CENTER" x="0" y="0"/>
				</Anchors>
				<!-- Initial color matches Config.lua defaults.colors.xpBar -->
				<BarColor r="0.58" g="0.0" b="0.55"/>
				<BarTexture file="Interface\Buttons\WHITE8X8"/>
				<Layers>
					<!-- Rested XP overlay - BEHIND status bar fill, starts from 0 -->
					<!-- Width = currentXP + restedXP, positioned in BACKGROUND so it's behind the bar fill -->
					<Layer level="BACKGROUND" textureSubLevel="-1">
						<Texture parentKey="RestedOverlay" hidden="true" file="Interface\Buttons\WHITE8X8">
							<Size x="0" y="30"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" relativeKey="$parent" relativePoint="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
							<!-- Initial color matches Config.lua defaults.colors.rested -->
							<Color r="0.07" g="0.58" b="0.95" a="0.5"/>
						</Texture>
					</Layer>
					
					<!-- Quest overlay - complete quests - on top of StatusBar fill -->
					<Layer level="ARTWORK" textureSubLevel="1">
						<Texture parentKey="QuestOverlayComplete" hidden="true" file="Interface\Buttons\WHITE8X8">
							<Size x="0" y="30"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
							<!-- Initial color matches Config.lua defaults.colors.questComplete -->
							<Color r="1.0" g="0.65" b="0.0" a="0.85"/>
						</Texture>
					</Layer>

					<!-- Quest overlay - incomplete quests -->
					<Layer level="ARTWORK" textureSubLevel="2">
						<Texture parentKey="QuestOverlayIncomplete" hidden="true" file="Interface\Buttons\WHITE8X8">
							<Size x="0" y="30"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
							<!-- Initial color matches Config.lua defaults.colors.questIncomplete -->
							<Color r="0.5" g="1.0" b="0.2" a="0.85"/>
						</Texture>
					</Layer>
				</Layers>
			</StatusBar>

			<!-- Overlay frame for ON-BAR text (separate from StatusBar for proper layering) -->
			<Frame parentKey="OverlayFrameTextContainer" frameStrata="MEDIUM" setAllPoints="true">
				<Layers>
					<Layer level="ARTWORK" textureSubLevel="5">
						<!-- Level text - left side -->
						<FontString parentKey="LevelText" inherits="TextStatusBarTextLarge" hidden="true">
							<Anchors>
								<Anchor point="LEFT" x="8" y="0"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="2" y="-2"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>

						<!-- XP text - center -->
						<FontString parentKey="XPText" inherits="TextStatusBarTextLarge" hidden="true">
							<Anchors>
								<Anchor point="CENTER" x="0" y="0"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="2" y="-2"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>

						<!-- Percent text - right side -->
						<FontString parentKey="PercentText" inherits="TextStatusBarTextLarge" hidden="true">
							<Anchors>
								<Anchor point="RIGHT" x="-8" y="0"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="2" y="-2"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>
					</Layer>
				</Layers>
			</Frame>

			<!-- BELOW-BAR text container (matches BaseMixin expectations) -->
			<Frame parentKey="BelowBarTextContainer" frameStrata="MEDIUM">
				<Size x="565" y="30"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="0" y="-2"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<!-- Rate text (XP/hour + time to level) - below bar on left -->
						<FontString parentKey="RateText" inherits="GameFontNormal" hidden="true">
							<Anchors>
								<Anchor point="TOPLEFT" x="0" y="0"/>
							</Anchors>
							<Color r="0.8" g="0.8" b="0.8"/>
						</FontString>

						<!-- Session text (session time + level time) - below bar on right -->
						<FontString parentKey="SessionText" inherits="GameFontNormal" hidden="true">
							<Anchors>
								<Anchor point="TOPRIGHT" x="0" y="0"/>
							</Anchors>
							<Color r="0.8" g="0.8" b="0.8"/>
						</FontString>
						
						<!-- Quest summary text (quests + rested) - below bar center -->
						<FontString parentKey="QuestSummaryText" inherits="GameFontNormal" hidden="true">
							<Anchors>
								<Anchor point="TOP" x="0" y="-12"/>
							</Anchors>
							<Color r="0.8" g="0.8" b="0.8"/>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEvent method="OnEvent"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
	</Frame>

</Ui>
