<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

	<!-- XP Bar Enhanced - VerticalBar Template  -->
	<!-- Vertical XP bar with StatusBar widget and vertical orientation -->

	<Script file="VerticalBarStyle.lua"/>

	<Frame name="VerticalBarTemplate" virtual="true" mixin="VerticalBarXPBarMixin" frameStrata="LOW" enableMouse="true" fixedFrameStrata="true">
		<Size x="60" y="300"/>
		<Layers>
			<!-- Background layer -->
			<Layer level="BACKGROUND" textureSubLevel="1">
				<Texture parentKey="Background" setAllPoints="true">
					<Color r="0" g="0" b="0" a="0.5"/>
				</Texture>
			</Layer>

			<!-- Rested overlay (behind StatusBar - grows from bottom) -->
			<Layer level="BACKGROUND" textureSubLevel="2">
				<Texture parentKey="RestedOverlay" hidden="true" file="Interface\Buttons\WHITE8X8">
					<Size x="60" y="0"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="0" y="0"/>
					</Anchors>
					<!-- Initial color matches Config.lua defaults.colors.rested -->
					<Color r="0.07" g="0.58" b="0.95" a="0.5"/>
				</Texture>
			</Layer>

			<!-- Flash effect overlay (full bar coverage) -->
			<Layer level="OVERLAY" textureSubLevel="3">
				<Texture parentKey="GainFlash" hidden="true" alphaMode="BLEND">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<!-- XP StatusBar (vertical orientation) -->
			<StatusBar parentKey="StatusBar" minValue="0" maxValue="1" defaultValue="0" orientation="VERTICAL">
				<Size x="60" y="300"/>
				<Anchors>
					<Anchor point="CENTER" x="0" y="0"/>
				</Anchors>
				<!-- Initial color matches Config.lua defaults.colors.xpBar -->
				<BarColor r="0.58" g="0.0" b="0.55"/>
				<BarTexture file="Interface\Buttons\WHITE8X8"/>
				<Layers>
					<!-- Quest overlay - complete quests - on top of StatusBar fill -->
					<Layer level="ARTWORK" textureSubLevel="1">
						<Texture parentKey="QuestOverlayComplete" hidden="true" file="Interface\Buttons\WHITE8X8">
							<Size x="60" y="0"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
							<!-- Initial color matches Config.lua defaults.colors.questComplete -->
							<Color r="1.0" g="0.65" b="0.0" a="0.85"/>
						</Texture>
					</Layer>

					<!-- Quest overlay - incomplete quests -->
					<Layer level="ARTWORK" textureSubLevel="2">
						<Texture parentKey="QuestOverlayIncomplete" hidden="true" file="Interface\Buttons\WHITE8X8">
							<Size x="60" y="0"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
							<!-- Initial color matches Config.lua defaults.colors.questIncomplete -->
							<Color r="0.5" g="1.0" b="0.2" a="0.85"/>
						</Texture>
					</Layer>
				</Layers>
			</StatusBar>

			<!-- Overlay frame for ON-BAR text (separate from StatusBar for proper layering) -->
			<Frame parentKey="OverlayFrameTextContainer" frameStrata="MEDIUM" setAllPoints="true">
				<Layers>
					<Layer level="ARTWORK" textureSubLevel="5">
						<!-- Level text - top of bar -->
						<FontString parentKey="LevelText" inherits="GameFontNormalHuge" hidden="true">
							<Anchors>
								<Anchor point="TOP" x="0" y="-10"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="1" y="-1"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>

						<!-- Percent text - center of bar -->
						<FontString parentKey="PercentText" inherits="GameFontNormalLarge" hidden="true">
							<Anchors>
								<Anchor point="CENTER" x="0" y="0"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="1" y="-1"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>

						<!-- XP/hour text - bottom of bar -->
						<FontString parentKey="RateText" inherits="GameFontNormalSmall" hidden="true">
							<Anchors>
								<Anchor point="BOTTOM" x="0" y="10"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="1" y="-1"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEvent method="OnEvent"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
	</Frame>

</Ui>
