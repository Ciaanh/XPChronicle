<Ui xmlns="http://www.blizzard.com/wow/ui/"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\Blizzard_SharedXML\UI.xsd">

	<!-- Legacy XP Bar Template (simplified from StatusTrackingBarTemplate) -->
	<Frame name="XPC_LegacyXPBarTemplate" virtual="true" mixin="XPC_LegacyXPBarMixin" frameStrata="LOW" enableMouse="true" fixedFrameStrata="true">
		<Size x="565" y="11"/>
		<Layers>
			<!-- Flash effect overlay (solid color for customization) -->
			<Layer level="OVERLAY" textureSubLevel="3">
				<Texture parentKey="GainFlash" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<Color r="1.0" g="1.0" b="1.0" a="0.0"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<!-- XP StatusBar (no inheritance - direct implementation) -->
			<StatusBar parentKey="StatusBar" minValue="0" maxValue="1" defaultValue="0">
				<Size x="565" y="10"/>
				<Anchors>
					<Anchor point="BOTTOMLEFT" x="0" y="0"/>
					<Anchor point="BOTTOMRIGHT" x="0" y="0"/>
				</Anchors>
				<BarColor r="1" g="1" b="1"/>
				<!-- Base texture file - uses solid color for customization -->
				<BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture parentKey="Background" atlas="UI-HUD-ExperienceBar-Background">
							<Anchors>
								<Anchor point="TOPLEFT"/>
								<Anchor point="BOTTOMRIGHT"/>
							</Anchors>
						</Texture>
					</Layer>

					<!-- Rested XP overlay (solid texture for customization) - now on StatusBar -->
					<Layer level="ARTWORK" textureSubLevel="-1">
						<Texture parentKey="ExhaustionLevelFillBar" file="Interface\TargetingFrame\UI-StatusBar">
							<Size x="0" y="10"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
							<Color r="0.0" g="0.5" b="1.0" a="0.5"/>
						</Texture>
					</Layer>

					<!-- Quest XP overlay - complete quests - now on StatusBar -->
					<Layer level="OVERLAY" textureSubLevel="1">
						<Texture parentKey="QuestOverlayComplete" hidden="true" file="Interface\TargetingFrame\UI-StatusBar">
							<Size x="0" y="10"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
							<Color r="1.0" g="0.59" b="0.0" a="0.8"/>
						</Texture>
					</Layer>

					<!-- Quest XP overlay - incomplete quests - now on StatusBar -->
					<Layer level="OVERLAY" textureSubLevel="2">
						<Texture parentKey="QuestOverlayIncomplete" hidden="true" file="Interface\TargetingFrame\UI-StatusBar">
							<Size x="0" y="10"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="0" y="0"/>
							</Anchors>
							<Color r="1.0" g="0.82" b="0.31" a="0.6"/>
						</Texture>
					</Layer>

				</Layers>
				<Frames>
					<!-- Exhaustion Tick (rested marker) -->
					<Button parentKey="ExhaustionTick" hidden="true" frameStrata="MEDIUM" mixin="XPC_ExhaustionTickMixin">
						<Size x="10" y="14"/>
						<Anchors>
							<Anchor point="CENTER" relativeKey="$parent.ExhaustionLevelFillBar" relativePoint="RIGHT"/>
						</Anchors>
						<NormalTexture parentKey="Normal" atlas="UI-HUD-ExperienceBar-Frame-Pip"/>
						<HighlightTexture parentKey="Highlight" atlas="UI-HUD-ExperienceBar-Frame-Pip-Mouseover" alphaMode="ADD"/>
						<Scripts>
							<OnEnter method="OnEnter"/>
							<OnLeave function="GameTooltip_Hide"/>
						</Scripts>
					</Button>
				</Frames>
			</StatusBar>


			<Frame parentKey="OverlayFrame" frameStrata="MEDIUM" setAllPoints="true">
				<Layers>
					<Layer level="ARTWORK" textureSubLevel="5">
						<!-- Level text - left side -->
						<FontString parentKey="LevelText" inherits="TextStatusBarText" hidden="true">
							<Anchors>
								<Anchor point="LEFT" x="8" y="1"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="2" y="-2"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>
						<!-- XP text - center -->
						<FontString parentKey="XPText" inherits="TextStatusBarText" hidden="true">
							<Anchors>
								<Anchor point="CENTER" x="0" y="1"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="2" y="-2"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>
						<!-- Percent text - right side -->
						<FontString parentKey="PercentText" inherits="TextStatusBarText" hidden="true">
							<Anchors>
								<Anchor point="RIGHT" x="-8" y="1"/>
							</Anchors>
							<Color r="1.0" g="1.0" b="1.0"/>
							<Shadow>
								<Offset x="2" y="-2"/>
								<Color r="0" g="0" b="0" a="0.8"/>
							</Shadow>
						</FontString>
					</Layer>
				</Layers>
			</Frame>


		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEvent method="OnEvent"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
	</Frame>

	<!-- Container Template (holds border and bar) -->
	<Frame name="XPC_LegacyXPBarContainerTemplate" virtual="true" mixin="XPC_LegacyXPBarContainerMixin">
		<Size x="571" y="17"/>
		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="BarFrameTexture" atlas="UI-HUD-ExperienceBar-Frame" useAtlasSize="true"/>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="Bar" inherits="XPC_LegacyXPBarTemplate">
				<Anchors>
					<Anchor point="BOTTOMLEFT" x="1" y="5"/>
				</Anchors>
			</Frame>
			<!-- Below-bar text container -->
			<Frame parentKey="BelowBarTextContainer" inherits="XPC_BelowBarTextContainerTemplate">
				<Anchors>
					<Anchor point="TOP" relativePoint="BOTTOM" x="0" y="0"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
		</Scripts>
	</Frame>

	<!-- Main Legacy XP Bar Instance (hidden by default - controller shows based on barStyle) -->
	<!-- Position set in Lua to match Blizzard's XP bar exactly -->
	<Frame name="XPC_LegacyXPBar" parent="UIParent" inherits="XPC_LegacyXPBarContainerTemplate" hidden="true">
		<!-- Default position if Blizzard bar not found -->
		<Anchors>
			<Anchor point="BOTTOM" relativePoint="BOTTOM" x="0" y="12"/>
		</Anchors>
	</Frame>

</Ui>
