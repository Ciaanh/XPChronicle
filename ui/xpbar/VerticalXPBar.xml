<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\Blizzard_SharedXML\UI.xsd">
    <Script file="VerticalXPBarMixin.lua"/>

    <!-- Vertical XP Bar Template -->
    <Frame name="VerticalXPBarTemplate" mixin="VerticalXPBarMixin" virtual="true" enableMouse="true" frameStrata="MEDIUM">
        <Size x="60" y="300"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnEvent method="OnEvent"/>
            <OnMouseUp method="OnMouseUp"/>
            <OnShow method="OnShow"/>
        </Scripts>
    </Frame>

    <!-- Vertical XP Bar Instance -->
    <Frame name="VerticalXPBar" inherits="VerticalXPBarTemplate" parent="UIParent" hidden="true">
        <Anchors>
            <Anchor point="RIGHT" relativePoint="RIGHT" x="-50" y="0"/>
        </Anchors>
    </Frame>
</Ui>