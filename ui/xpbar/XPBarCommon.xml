<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

	<!-- Below-bar text container template (shared by both Legacy and Flat bars) -->
	<Frame name="BelowBarTextContainerTemplate" virtual="true">
		<Size x="565" y="40"/>
		<Layers>
			<Layer level="OVERLAY">
				<!-- Rate text (XP/hour + time to level) -->
				<FontString parentKey="RateText" inherits="GameFontNormal" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="0" y="-2"/>
					</Anchors>
					<Color r="0.8" g="0.8" b="0.8"/>
				</FontString>
				<!-- Session text (session time + level time) -->
				<FontString parentKey="SessionText" inherits="GameFontNormal" hidden="true">
					<Anchors>
						<Anchor point="TOPRIGHT" x="0" y="-2"/>
					</Anchors>
					<Color r="0.8" g="0.8" b="0.8"/>
				</FontString>
				<!-- Quest summary text (quests + rested) -->
				<FontString parentKey="QuestSummaryText" inherits="GameFontNormal" hidden="true">
					<Anchors>
						<Anchor point="TOP" x="0" y="-14"/>
					</Anchors>
					<Color r="0.8" g="0.8" b="0.8"/>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

</Ui>
