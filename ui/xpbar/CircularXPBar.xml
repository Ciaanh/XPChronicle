<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\Blizzard_SharedXML\UI.xsd">
    <Script file="CircularXPBarMixin.lua"/>

    <!-- Circular XP Bar Template -->
    <Frame name="CircularXPBarTemplate" mixin="CircularXPBarMixin" virtual="true" enableMouse="true" frameStrata="MEDIUM">
        <Size x="150" y="150"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnEvent method="OnEvent"/>
            <OnMouseUp method="OnMouseUp"/>
            <OnShow method="OnShow"/>
        </Scripts>
    </Frame>

    <!-- Circular XP Bar Instance -->
    <Frame name="CircularXPBar" inherits="CircularXPBarTemplate" parent="UIParent" hidden="true">
        <Anchors>
            <Anchor point="CENTER" relativePoint="CENTER" x="0" y="-200"/>
        </Anchors>
    </Frame>
</Ui>