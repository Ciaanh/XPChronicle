<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\Blizzard_SharedXML\UI.xsd">
    <Script file="VerticalXPBarMixin.lua"/>

    <!-- Vertical XP Bar Template (view) -->
    <Frame name="VerticalXPBarTemplate" mixin="VerticalXPBarMixin" virtual="true" enableMouse="true" frameStrata="MEDIUM">
        <Size x="60" y="300"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnEvent method="OnEvent"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
            <OnMouseDown method="OnMouseDown"/>
            <OnMouseUp method="OnMouseUp"/>
            <OnShow method="OnShow"/>
        </Scripts>
    </Frame>

    <!-- Container Template for Vertical XP Bar -->
    <Frame name="VerticalXPBarContainerTemplate" virtual="true" mixin="VerticalXPBarContainerMixin">
        <Size x="60" y="300"/>
        <Frames>
            <Frame parentKey="Bar" inherits="VerticalXPBarTemplate">
                <Anchors>
                    <Anchor point="CENTER" x="0" y="0"/>
                </Anchors>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
        </Scripts>
    </Frame>

    <!-- Vertical XP Bar Container Instance (hidden by default) -->
    <Frame name="VerticalXPBar" parent="UIParent" inherits="VerticalXPBarContainerTemplate" hidden="true">
        <Anchors>
            <Anchor point="CENTER" relativePoint="CENTER" x="0" y="0"/>
        </Anchors>
    </Frame>
</Ui>